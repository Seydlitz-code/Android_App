<?xml version="1.0" encoding="utf-8"?>
<!-- 동일 Wi‑Fi LAN HTTP(cleartext) — 사설 IP·localhost 업/다운로드 허용 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
